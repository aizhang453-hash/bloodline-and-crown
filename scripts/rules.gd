class_name Rules
extends RefCounted
## 开局设置 (照三代的「游戏规则」: 开局前选好, 开始以后不能改)。
## 生成家人、铁人模式是三代有的; 孩子夭折、史料里的婚事和孩子、史料里的仗是我们定过的规矩, 也让玩家自己挑。

## 每条规则: [id, 名字, 说明, [[选项的值, 选项的名字], ...]]; 第一个选项是默认的
const LIST := [
	["generate_families", "生成家人", "有领地、没家人的人, 开局配妻子和能继承的儿子 (妻子年纪大些再多一两个孩子)",
		[["on", "开"], ["ai", "只给电脑"], ["off", "关"]]],
	["ironman", "铁人模式", "不能自己存档、读档; 每半年和退出时自动存一个档。家族没了只能重新开一局",
		[["off", "关"], ["on", "开"]]],
	["child_death", "孩子夭折", "小孩长不到 16 岁的有多少",
		[["normal", "五个里一个"], ["history", "照史实, 三个里一个"], ["low", "少, 十个里一个"]]],
	["history", "历史上的婚事和孩子", "开局以后历史上发生过的婚事照着安排, 这对夫妻生的孩子用历史上的名字",
		[["on", "照历史来"], ["off", "不照历史"]]],
	["wars", "历史上的仗和阴谋", "开局维京大军和诺森布里亚就在打; 以后历史上的仗、援兵、阴谋到时候照着来 (成不成看真的)",
		[["on", "照历史来"], ["off", "不照历史"]]],
]

## 孩子的健康 (婴儿, 1–4 岁, 5–9 岁, 10–15 岁), 按「孩子夭折」这条规则 (量过: 大约 20%、31%、11% 长不到 16 岁)
const CHILD_HEALTH := {
	"normal": [-1.5, -0.8, 0.0, 0.0],
	"history": [-3.0, -1.6, -0.4, 0.0],
	"low": [0.0, 0.3, 1.0, 1.0],
}


static func defaults() -> Dictionary:
	var d := {}
	for r in LIST:
		d[r[0]] = r[3][0][0]
	return d


static func option_name(id: String, value: String) -> String:
	for r in LIST:
		if r[0] == id:
			for o in r[3]:
				if o[0] == value:
					return o[1]
	return value
